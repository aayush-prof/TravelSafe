# =============================================================================
# TravelSafe Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
#
# Usage:
#   1. Copy: cp .env.example .env
#   2. Edit .env and add your API key
#   3. The app will automatically load variables from .env
# =============================================================================

# -----------------------------------------------------------------------------
# News API Configuration
# -----------------------------------------------------------------------------
# Get your free API key from: https://newsapi.org/
# Free tier allows 100 requests per day
#
# Leave empty to use sample data (default behavior)
NEWS_API_KEY=

# -----------------------------------------------------------------------------
# OpenWeatherMap API Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://openweathermap.org/api
# Used for real-time weather data and alerts
#
# API call format:
# https://api.openweathermap.org/data/3.0/onecall?lat={lat}&lon={lon}&exclude={part}&appid={API key}
#
OPENWEATHER_API_KEY=

# -----------------------------------------------------------------------------
# GNews API Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://gnews.io/
# Used for real-time crime news fetching
# Free tier: 100 requests per day
#
GNEWS_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Override default settings
# -----------------------------------------------------------------------------
# Uncomment and modify these to override config.py defaults

# Enable live news fetching (requires valid NEWS_API_KEY)
# USE_LIVE_NEWS=True

# Number of news articles to fetch per city
# NEWS_FETCH_LIMIT=20

# Cache timeout in seconds (0 to disable, default 900 = 15 minutes)
# CACHE_TIMEOUT=900
