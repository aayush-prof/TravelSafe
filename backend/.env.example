# =============================================================================
# TravelSafe backend settings. Copy this file to backend/.env and fill in.
#
#   PowerShell:  Copy-Item backend\.env.example backend\.env
#
# Keys belong ONLY here (or in a project-root .env). Never put them in
# frontend/.env.local: the browser must never see them, and the backend
# doesn't read that file. Never commit the real .env.
# Every key is optional: the app starts without any of them and says
# plainly which sources are missing. Edits are picked up without a restart.
# =============================================================================

# --- Weather ------------------------------------------------------------------
# OpenWeatherMap key (canonical name). Legacy names OPENWEATHERMAP_API_KEY,
# WEATHER_API_KEY and OWM_API_KEY are also accepted (and flagged).
# A new key can take a while to activate; until then OpenWeatherMap answers 401
# and the app falls back to Open-Meteo. Official alerts need the separate
# One Call 3.0 subscription.
OPENWEATHER_API_KEY=
# Open-Meteo: weather fallback and modelled air quality. No key needed.
OPEN_METEO_ENABLED=true

# --- Air quality -------------------------------------------------------------
# OpenAQ v3 key (free, https://explore.openaq.org/register). Without it air
# quality is shown as "not assessed" - never as clean air.
OPENAQ_API_KEY=

# --- Natural hazards (no keys) -----------------------------------------------
USGS_ENABLED=true
GDACS_ENABLED=true

# --- News (all optional) -----------------------------------------------------
# NewsAPI.org key (legacy name NEWSAPI_KEY accepted)
NEWS_API_KEY=
# GNews.io key
GNEWS_API_KEY=
# Google News RSS needs no key. Set to false to disable it.
ENABLE_GOOGLE_NEWS_RSS=true
# Articles requested per provider per city
NEWS_FETCH_LIMIT=30

# --- Behaviour -----------------------------------------------------------------
# auto   = live news; if every news provider fails, use labelled sample headlines
#          (only for Delhi, Mumbai, Bangalore, Chennai, Hyderabad)
# live   = live only, never sample data
# sample = sample headlines only (offline demo; live feeds are not mixed in)
DATA_MODE=auto
# Seconds a successful result is cached (failures are retried after 60 s)
CACHE_TTL_SECONDS=900
# Retries for timeouts, 429 and 5xx (never for 401/403/404)
HTTP_RETRIES=2
# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
