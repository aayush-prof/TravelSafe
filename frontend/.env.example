# TravelSafe frontend. Optional: copy to frontend/.env.local only if the
# backend is NOT at http://127.0.0.1:8000.
# Do NOT put API keys here. They belong in backend/.env.
#
# Address of the FastAPI backend as seen from the browser (report downloads)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Address used by the Next.js server, if different (e.g. Docker)
# API_BASE_URL=http://127.0.0.1:8000
